  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"Test1234!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signUp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signUp"
              ]
            },
            "description": "Inscription d'un nouvel utilisateur. Le mot de passe doit contenir au moins 8 caractères avec majuscule, minuscule, chiffre et caractère spécial."
          },
          "response": []
        },
        {
          "name": "Sign In",
          "request": {
            "method": "POST",
            "header": [
