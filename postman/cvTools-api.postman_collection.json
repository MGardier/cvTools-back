            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"Test1234!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signIn",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signIn"
              ]
            },
            "description": "Connexion d'un utilisateur. Retourne accessToken et refreshToken."
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
