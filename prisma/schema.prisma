// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}






// ================================================
//                  USER
// ================================================

enum UserStatus {
  ALLOWED
  PENDING
  BANNED
}

enum UserRoles {
  ADMIN
  USER
}

enum LoginMethod {
  CLASSIC
  GITHUB
  GOOGLE
}

model User {
  @@map("user")

  // Int
  id          Int        @id @default(autoincrement())

  // String
  email       String     @unique @db.VarChar(100)
  password    String?    @db.VarChar(150)
  oauthId     String?    @map("oauth_id") @db.VarChar(150)

  // DateTime
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime?  @updatedAt @map("updated_at")

  // Enum
  status      UserStatus  @default(ALLOWED)
  roles       UserRoles
  loginMethod LoginMethod @map("login_method")

  // Relations
  tokens                UserToken[]
  providerLogs          ProviderLogger[]
  providerUsageRecords  ProviderUsageRecord[]

  @@unique([loginMethod, oauthId], name: "unique_oauth_user")
}


// ================================================
//                  USER TOKEN
// ================================================



enum PrismaTokenType {
  REFRESH
  FORGOT_PASSWORD
  CONFIRM_ACCOUNT
}


model UserToken {
  @@map("user_token")

  // Int
  id        Int             @id @default(autoincrement())

  // String
  token     String          @db.Text
  uuid      String?         @unique @db.VarChar(150)

  // DateTime
  expiresAt DateTime        @map("expires_at")
  createdAt DateTime        @default(now()) @map("created_at")

  // Enum
  type      PrismaTokenType

  // Foreign keys
  userId    Int             @map("user_id")

  //Relations
  user      User            @relation(fields: [userId], references: [id])
}


// ================================================
//                  ADMIN INVITATION
// ================================================

model AdminInvitation {
  @@map("admin_invitation")

  // Int
  id        Int       @id @default(autoincrement())

  // String
  email     String    @db.VarChar(100)
  uuid      String    @unique @db.VarChar(150)
  tokenHash String    @map("token_hash") @db.Text

  // DateTime
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
}


// ================================================
//                  PROVIDER LOGGER
// ================================================

enum ExternalProvider {
  CLAUDE
  GEMINI
  ADZUNA
  FRANCE_TRAVAIL
  APIFY
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}


model ProviderLogger {
  @@map("provider_logger")

  // Int
  id            Int    @id @default(autoincrement())
  statusCode    Int    @map("status_code") @db.SmallInt

  // String
  operationPath String @map("operation_path") @db.VarChar(50)

  // DateTime
  createdAt     DateTime @default(now()) @map("created_at")

  // Enum
  method        HttpMethod
  provider      ExternalProvider

  // Json
  request       Json
  response      Json

  // Foreign keys
  usedBy        Int  @map("used_by")
  user          User @relation(fields: [usedBy], references: [id])

  @@index([usedBy])
  @@index([provider])
}

// ================================================
//                  PROVIDER USAGE RECORD
// ================================================

model ProviderUsageRecord {
  @@map("provider_usage_record")

  // Int
  id             Int    @id @default(autoincrement())
  requestCount   Int    @default(0) @map("request_count")
  tokensConsumed Int    @default(0) @map("tokens_consumed")

  // DateTime
  periodStartAt  DateTime  @map("period_start_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  // Enum
  provider       ExternalProvider

  // Foreign keys
  userId         Int  @map("user_id")

  //Relations
  user           User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([provider])
  @@unique([userId, provider, periodStartAt])
}

